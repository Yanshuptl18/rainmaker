# The key we sent you: an OpenRouter key (sk-or-v1-...) with a hard spending cap.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# FalkorDB, started by docker compose
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Graphiti sends anonymous telemetry on start-up unless this is set.
GRAPHITI_TELEMETRY_ENABLED=false
